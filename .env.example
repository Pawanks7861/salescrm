# =============================================================================
# Sales CRM environment template.
# Copy to .env and fill in. NEVER commit .env or put real secrets in this file.
# Defaults below are production-safe. For local development override:
#   APP_ENV=local  APP_DEBUG=true  APP_URL=http://localhost
#   SESSION_SECURE_COOKIE=false  LOG_LEVEL=debug  MAIL_MAILER=log
#   TELEPHONY_DRIVER=fake (optional simulator; refused outside local/testing)
# After changing values on a server: php artisan config:cache
# Verify with: php artisan app:production-check
# =============================================================================

# ----- Application -----------------------------------------------------------
APP_NAME="Sales CRM"
APP_ENV=production
# Generate once per environment: php artisan key:generate (never reuse across clients)
APP_KEY=
APP_DEBUG=false
# Must be https:// in production
APP_URL=https://crm.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

VITE_APP_NAME="${APP_NAME}"

# ----- Database (MySQL 8 / MariaDB 10.6+, utf8mb4, strict mode) --------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salescrm
# Dedicated least-privilege user; never root in production
DB_USERNAME=
DB_PASSWORD=
# Session time zone; keep UTC (the app stores UTC)
DB_TIMEZONE=+00:00

# Non-production only: `php artisan db:seed` creates this Super Admin (password
# generated and printed once if empty). Production: php artisan crm:create-super-admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ----- Session ---------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production (cookie sent over HTTPS only)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ----- Cache -----------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ----- Queue (never "sync" in production; run a worker, see docs/OPERATIONS.md)
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ----- Mail (SMTP) -----------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ----- Meta / Facebook Lead Ads (docs/FACEBOOK_INTEGRATION.md) ---------------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Check the Graph API changelog before changing the version.
META_GRAPH_VERSION=v25.0
# Empty = the /admin/integrations/facebook/callback route.
META_OAUTH_REDIRECT_URI=
# Super Admin system-user token form (Development / Advanced). Keep false in production.
META_ALLOW_MANUAL_TOKEN=false

# ----- Telephony (docs/TELEPHONY_MODULE.md) ----------------------------------
# exotel in every shared/production environment; "fake" works only when APP_ENV is local/testing.
TELEPHONY_DRIVER=exotel
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# api.exotel.com (Singapore cluster) or api.in.exotel.com (Mumbai cluster)
EXOTEL_SUBDOMAIN=
# Long random string; appended to the callback URLs configured in Exotel.
EXOTEL_WEBHOOK_SECRET=
EXOTEL_DEFAULT_CALLER_ID=
# Optional: comma-separated Exotel egress IPs/CIDRs for the callback endpoints.
EXOTEL_WEBHOOK_ALLOWED_IPS=
# Browser calling (Exotel CRM Web SDK). Leave empty to use click-to-call only.
EXOTEL_WEBRTC_ACCESS_TOKEN=
EXOTEL_WEBRTC_SDK_URL=

# ----- Browser push notifications (php artisan webpush:vapid) ----------------
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=

# ----- Storage ---------------------------------------------------------------
# Private files (attachments, recordings, exports) stay on the "local" disk
# under storage/app/private; include it in backups.
FILESYSTEM_DISK=local
TELEPHONY_RECORDING_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----- Reporting / features --------------------------------------------------
# Lead estimated value is hidden from UI/exports while false (data is retained)
CRM_LEAD_VALUE_ENABLED=false

# Set true only to recover if Settings → Security locked sign-in to the wrong WiFi IP.
# Then run: php artisan config:cache
OFFICE_WIFI_BYPASS=false

# ----- Logging ---------------------------------------------------------------
LOG_CHANNEL=stack
# daily = one file per day, kept LOG_DAILY_DAYS days (audit logs live in the database and are not pruned)
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
